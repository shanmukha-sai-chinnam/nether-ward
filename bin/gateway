#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
cd "$ROOT_DIR"

if [ ! -d ".venv" ]; then
  echo "Error: Virtual environment .venv not found. Run 'uv venv .venv && source .venv/bin/activate && uv pip install \"litellm[proxy]\"' first." >&2
  exit 1
fi

HOST=$(jq -r '.gateway.host' values.json 2>/dev/null || echo "127.0.0.1")
PORT=$(jq -r '.gateway.port' values.json 2>/dev/null || echo "4000")
CONFIG_FILE="config/litellm_config.yaml"

echo -e "\033[1;34m==>\033[0m \033[1mStarting LiteLLM AI Gateway on http://${HOST}:${PORT}...\033[0m"
echo -e "\033[1;34m==>\033[0m \033[1mConfig:\033[0m ${CONFIG_FILE}"

exec .venv/bin/litellm \
  --config "$CONFIG_FILE" \
  --host "$HOST" \
  --port "$PORT" \
  --telemetry False \
  "$@"
