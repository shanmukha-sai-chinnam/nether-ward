#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
cd "$ROOT_DIR"

# Self-bootstrap via Nix flake if environment tools are not in PATH
if [ -z "${AI_INFRA_SHELL:-}" ] && ! command -v node >/dev/null 2>&1; then
  exec nix develop "$ROOT_DIR" --command "$0" "$@"
fi

# Load GEMINI_API_KEY from .env if unset in current environment
if [ -z "${GEMINI_API_KEY:-}" ] && [ -f ".env" ]; then
  KEY_LINE=$(grep -E '^(GEMINI_API_KEY|GOOGLE_API_KEY)=' .env | head -n 1 || true)
  if [ -n "$KEY_LINE" ]; then
    VAL=$(echo "$KEY_LINE" | cut -d'=' -f2- | tr -d '"'"'")
    export GEMINI_API_KEY="$VAL"
  fi
fi

if [ -z "${GEMINI_API_KEY:-}" ]; then
  echo -e "\033[1;31mError: GEMINI_API_KEY is not set.\033[0m" >&2
  echo "Export GEMINI_API_KEY or configure it in .env or GitHub Secrets." >&2
  exit 1
fi

export PROMPTFOO_DISABLE_TELEMETRY=1
mkdir -p reports
CONFIG_FILE="config/redteam_config.yaml"

echo -e "\033[1;34m==>\033[0m \033[1mStarting Synthetic AI Red Team Security Evaluation...\033[0m"
echo -e "\033[1;34m==>\033[0m \033[1mConfig:\033[0m ${CONFIG_FILE}"
echo -e "\033[1;34m==>\033[0m \033[1mTesting OWASP Top 10 for LLMs Vulnerability Scenarios...\033[0m"

PROMPTFOO_BIN="./node_modules/.bin/promptfoo"
if [ ! -x "$PROMPTFOO_BIN" ]; then
  PROMPTFOO_BIN="npx --yes promptfoo@0.125.1"
fi

exec $PROMPTFOO_BIN eval \
  --config "$CONFIG_FILE" \
  --max-concurrency 2 \
  --no-share \
  --no-progress-bar \
  --output reports/redteam_report.json \
  --output reports/redteam_report.html \
  --output reports/redteam.junit.xml \
  "$@"
