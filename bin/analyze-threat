#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
cd "$ROOT_DIR"

# Self-bootstrap via Nix flake if environment tools are not in PATH
if [ -z "${AI_INFRA_SHELL:-}" ] && ! command -v python3 >/dev/null 2>&1; then
  exec nix develop "$ROOT_DIR" --command "$0" "$@"
fi

exec python3 "$ROOT_DIR/src/threat_analyzer.py" "$@"
